# Public values. Safe for the browser only when RLS and least-privilege
# grants are correctly configured in Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only elevated credential. Never expose it through NEXT_PUBLIC_.
# Do not configure it until a concrete server-only operation requires it.
SUPABASE_SECRET_KEY=

# Canonical application URL, used for auth redirects and metadata.
NEXT_PUBLIC_SITE_URL=
